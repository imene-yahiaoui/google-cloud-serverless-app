# ── Google Cloud ─────────────────────────────────────────────────────────────
# Required in production — must match your GCP project ID
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west9

# ── BigQuery ─────────────────────────────────────────────────────────────────
BIGQUERY_DATASET=document_pipeline
BIGQUERY_METADATA_TABLE=document_metadata
BIGQUERY_ERRORS_TABLE=processing_errors

# ── Pub/Sub ───────────────────────────────────────────────────────────────────
PUBSUB_TOPIC=document-processing
PUBSUB_DLQ_TOPIC=document-processing-dlq
PUBSUB_SUBSCRIPTION=document-processing-sub

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Local development only — remove or leave unset in production ───────────────
# These redirect SDK calls to local emulators running in Docker Compose.
# PUBSUB_EMULATOR_HOST=localhost:8085
# BIGQUERY_EMULATOR_HOST=localhost:9050
